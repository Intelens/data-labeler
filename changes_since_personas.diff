+def groups(items, token_budget=65536):
+    """Index batches of Tokenizer.encode() outputs, shortest histories first, each up to token_budget padded slots
+    (rows x events x tokens), so short and long histories are not padded together."""
+    n_ev = np.array([max(1, len(it["time"])) for it in items])
+    n_tok = np.array([1 + (int(np.bincount(it["evt"]).max()) if len(it["evt"]) else 0) for it in items])  # widest event, + [EVT]
+    order, out, i = np.argsort(n_ev, kind="stable"), [], 0
+    while i < len(order):
+        j, e_max, t_max = i, 1, 1
+        while j < len(order):
+            e_max, t_max = max(e_max, n_ev[order[j]]), max(t_max, n_tok[order[j]])
+            if j > i and (j - i + 1) * e_max * t_max > token_budget:
+                break
+            j += 1
+        out.append(order[i:j])
+        i = j
+    return out
+
