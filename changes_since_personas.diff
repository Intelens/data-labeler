+"""Pipeline 6 · LoRA fine-tuning per task: PRAGMA's main way to learn a downstream task (§3.1.2, Table 2).
+
+For each task (pipelines/downstream.py) the pretrained model of pipeline 4 gets LoRA adapters (rank 8, α 8, on QKV
+and the feed-forward layers; pragmaLib/lora.py) and a classification head, fine-tuned on the train customers'
+snapshots and scored on the test customers'. References, as in the paper: the probes on the frozen embedding
+(pipeline 5), and the counts baseline. Uplift = AUC(LoRA) - AUC(counts), and AUC(LoRA) - AUC(counts + embedding
+probe), with a 95% interval from resampling test customers; significant = Holm-adjusted p < 0.05 over all comparisons.
+
+Reads  models/<name>/ (pipeline 4), data/silver/ (pipeline 2), data/gold/split.json (pipeline 3)
+Writes reports/finetune_<name>.md + .json
+
+Run:  python pipelines/06_finetune.py [--name small] [--epochs 2] [--dates 4] [--tasks "opens the push it gets" ...]
+"""
+import argparse
+import json
+import time
+
+import numpy as np
+from common import MODELS, REPORTS
+from downstream import TASKS, holm, probe, snapshots, uplift
+from sklearn.metrics import roc_auc_score
+
+from pragmaLib.lora import finetune
+from pragmaLib.model import embed, load
+
+p = argparse.ArgumentParser()
+p.add_argument("--name", default="small")
+p.add_argument("--epochs", type=int, default=2)
+p.add_argument("--lr", type=float, default=1e-3)
+p.add_argument("--dates", type=int, default=4)
+p.add_argument("--boot", type=int, default=1000)
+p.add_argument("--tasks", nargs="*", default=list(TASKS))
+p.add_argument("--train-customers", type=int, default=None, help="a sample, for a quick test")
+p.add_argument("--test-customers", type=int, default=None)
+a = p.parse_args()
+model, tok = load(MODELS / a.name)
+s = snapshots(a.dates, a.train_customers, a.test_customers)
+te, Y = s["te"], s["Y"]
+items = [tok.encode(*r) for r in s["records"]]
+print(f"{len(items):,} snapshots ({te.sum():,} of test customers), model {a.name}", flush=True)
+E = embed(model, tok, s["records"])
+probes = {n: probe(X, Y, te, keep_predictions=True) for n, X in {"counts": s["base"], "embedding": E, "counts + embedding": np.hstack([s["base"], E])}.items()}
+
+results, tests = {}, {}
+for task in a.tasks:
+    j, ref = list(TASKS).index(task), probes["counts"][task]
+    if ref is None:
+        results[task] = {"skipped": "too few positives"}
+        continue
+    ok = Y[:, j] >= 0
+    tr, ts = np.flatnonzero(ok & ~te), ref["rows"]
+    t0 = time.time()
+    print(f"{task}: fine-tuning on {len(tr):,} train snapshots ({int(Y[tr, j].sum()):,} positives)", flush=True)
+    m, _ = load(MODELS / a.name)  # a fresh copy of the pretrained model per task
+    pl = finetune(m, [items[i] for i in tr], Y[tr, j], [items[i] for i in ts], epochs=a.epochs, lr=a.lr)
+    y = Y[ts, j]
+    pred = REPORTS / f"predictions_{a.name}"  # every method's test predictions, per task, for pipeline 7's KPIs
+    pred.mkdir(parents=True, exist_ok=True)
+    np.savez(pred / f"{task}.npz", y=y, group=s["group"][ts], LoRA=pl,
+             **{f"probe {n}": probes[n][task]["p"] for n in probes})
+    for other in ("counts", "counts + embedding"):
+        tests[(task, other)] = uplift(y, pl, probes[other][task]["p"], s["group"][ts], a.boot)
+    results[task] = {"n": len(ts), "positives": int(y.sum()), "seconds": round(time.time() - t0),
+                     "auc": {"LoRA": round(float(roc_auc_score(y, pl)), 4),
+                             **{n: probes[n][task]["auc"] for n in probes}}}
+    print(f"  AUC LoRA {results[task]['auc']['LoRA']:.3f} | counts {ref['auc']:.3f} | embedding probe {probes['embedding'][task]['auc']:.3f}"
+          f" | counts + embedding probe {probes['counts + embedding'][task]['auc']:.3f}  ({results[task]['seconds']} s)", flush=True)
+adj = holm({k: v[3] for k, v in tests.items()})
+for (task, other), (d, lo, hi, pv) in tests.items():
+    results[task][f"uplift over {other}"] = {"auc": round(d, 4), "low": round(lo, 4), "high": round(hi, 4), "p": round(pv, 4),
+                                             "p_holm": round(adj[(task, other)], 4), "significant": adj[(task, other)] < 0.05 and lo > 0}
+REPORTS.mkdir(exist_ok=True)
+(REPORTS / f"finetune_{a.name}.json").write_text(json.dumps({"model": a.name, "epochs": a.epochs, "lr": a.lr, "dates": a.dates, "tasks": results}, indent=2),
+                                                 encoding="utf-8")
+sig = lambda u: f"{u['auc']:+.3f} [{u['low']:+.3f}, {u['high']:+.3f}]{' **significant**' if u['significant'] else ''}"  # noqa: E731
+lines = [f"# LoRA fine-tuning per task ({a.name}), against the probes and the counts baseline", "",
+         f"LoRA rank 8, α 8 on QKV and feed-forward layers, plus a head on the customer embedding; Adam, lr {a.lr}, {a.epochs} epochs on the "
+         f"train customers' snapshots ({a.dates} snapshot dates, 7-day horizon), scored on the test customers'. Uplift: AUC difference with a "
+         f"95% interval from {a.boot} resamples of test customers; significant = Holm-adjusted p < 0.05 over all {len(tests)} comparisons.", "",
+         "| Task | Test rows (positives) | AUC LoRA | AUC counts | AUC embedding probe | AUC counts + embedding probe | LoRA − counts | LoRA − (counts + embedding) |",
+         "|---|---|---|---|---|---|---|---|"]
+for task, r in results.items():
+    if "skipped" in r:
+        lines.append(f"| {task} | {r['skipped']} | | | | | | |")
+        continue
+    au = r["auc"]
+    lines.append(f"| {task} | {r['n']:,} ({r['positives']:,}) | {au['LoRA']:.3f} | {au['counts']:.3f} | {au['embedding']:.3f} | {au['counts + embedding']:.3f} "
+                 f"| {sig(r['uplift over counts'])} | {sig(r['uplift over counts + embedding'])} |")
+(REPORTS / f"finetune_{a.name}.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
+print("\n".join(lines[6:]))
+print(f"-> {REPORTS / f'finetune_{a.name}.md'}")
