diff experiments/gpu.sh
--- /dev/null
+++ b/experiments/gpu.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# The GPU experiment on one fresh instance, from nothing to reports: environment, data, pretraining runs with
+# downstream evaluation during training, and the significance report per run. Logs in logs/; done = logs/done.txt.
+#   bash experiments/gpu.sh            (CUDA wheels: TORCH_INDEX=https://download.pytorch.org/whl/cu128 by default)
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p logs
+export PATH="$HOME/.local/bin:$PATH"
+command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null
+[ -x .venv/bin/python ] || uv venv --python 3.11 .venv -q
+uv pip install --python .venv -q torch --index-url "${TORCH_INDEX:-https://download.pytorch.org/whl/cu128}"
+uv pip install --python .venv -q numpy scikit-learn matplotlib
+PY=.venv/bin/python
+$PY -c "import torch; assert torch.cuda.is_available(), 'no GPU'; print(torch.__version__, torch.cuda.get_device_name())" | tee logs/env.txt
+[ -f data/gold/tokens/train.pkl ] || { $PY pipelines/01_bronze.py "${CUSTOMERS:-20000}" && $PY pipelines/02_silver.py && $PY pipelines/03_gold.py; } > logs/data.txt 2>&1
+run() {  # name, then pipeline-4 arguments
+  name=$1; shift
+  $PY pipelines/04_train.py --name "$name" --token-budget 32768 --eval-every 250 "$@" > "logs/04_$name.txt" 2>&1
+  $PY pipelines/05_downstream.py --name "$name" > "logs/05_$name.txt" 2>&1
+}
+for spec in ${RUNS:-"nano:nano:2000" "small:small:2000"}; do  # name:size:steps
+  IFS=: read -r name size steps <<< "$spec"
+  run "$name" --size "$size" --steps "$steps"
+done
+echo done > logs/done.txt
