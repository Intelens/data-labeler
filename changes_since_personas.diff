+"""LoRA fine-tuning per task, as PRAGMA adapts its foundation model (paper §3.1.2; LoRA: Hu et al. 2021).
+
+The pretrained weights stay frozen. In every block of the three encoders, the attention projection (QKV) and both
+feed-forward layers get a trainable low-rank update, W x + (α / r) · B A x, with rank r = 8 and α = 8 as in the
+paper; A starts random and B at zero, so fine-tuning starts exactly from the pretrained model. A classification head
+on the customer embedding (z_h at [USR]) is trained with them: Adam, binary cross-entropy, one model per task.
+"""
+import math
+
+import numpy as np
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+from .model import collate, groups
+
+
+class LoRALinear(nn.Module):
+    def __init__(self, base: nn.Linear, r=8, alpha=8):
+        super().__init__()
+        self.base, self.scale = base, alpha / r
+        self.A = nn.Parameter(torch.empty(r, base.in_features))
+        self.B = nn.Parameter(torch.zeros(base.out_features, r))
+        nn.init.kaiming_uniform_(self.A, a=math.sqrt(5))
+
+    def forward(self, x):
+        return self.base(x) + (x @ self.A.T.to(x.dtype)) @ self.B.T.to(x.dtype) * self.scale
+
+
+def add_lora(model, r=8, alpha=8) -> int:
+    """Freeze the model and put LoRA on QKV and the feed-forward layers of every encoder block. -> trainable weights."""
+    for p in model.parameters():
+        p.requires_grad_(False)
+    for enc in (model.event_enc, model.profile_enc, model.history_enc):
+        for blk in enc.blocks:
+            blk.qkv = LoRALinear(blk.qkv, r, alpha)
+            blk.ff[0], blk.ff[2] = LoRALinear(blk.ff[0], r, alpha), LoRALinear(blk.ff[2], r, alpha)
+    return sum(p.numel() for p in model.parameters() if p.requires_grad)
+
+
+def finetune(model, train, y, test, epochs=2, lr=1e-3, token_budget=32768, seed=0, log=print):
+    """train / test: Tokenizer.encode() outputs, y: 0 / 1 per train item. -> P(positive) per test item.
+    lr and epochs are not in the paper: GUESS, the usual LoRA range."""
+    torch.manual_seed(seed)
+    rng, dev = np.random.default_rng(seed), next(model.parameters()).device
+    n_lora = add_lora(model)
+    model.to(dev)
+    head = nn.Linear(model.dim, 1).to(dev)
+    opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad] + list(head.parameters()), lr=lr)
+    yt, cuda = torch.tensor(np.asarray(y, np.float32), device=dev), dev.type == "cuda"
+    train_batches, test_batches = groups(train, token_budget), groups(test, token_budget)
+
+    def logits(items, idx):
+        with torch.autocast(dev.type, dtype=torch.bfloat16, enabled=cuda):
+            return head(model(collate([items[i] for i in idx], dev))["user"]).float().squeeze(-1)
+
+    for ep in range(epochs):
+        model.train()
+        total = 0.0
+        for k in rng.permutation(len(train_batches)):
+            idx = train_batches[k]
+            loss = F.binary_cross_entropy_with_logits(logits(train, idx), yt[torch.as_tensor(idx, device=dev)])
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            opt.step()
+            total += loss.item() * len(idx)
+        log(f"  epoch {ep + 1}/{epochs}: loss {total / len(train):.4f} ({n_lora:,} LoRA weights + the head)")
+    model.eval()
+    p = np.zeros(len(test), np.float32)
+    with torch.no_grad():
+        for idx in test_batches:
+            p[idx] = torch.sigmoid(logits(test, idx)).cpu().numpy()
+    return p
