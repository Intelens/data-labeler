@@ -0,0 +1,117 @@
+"""Pipeline 7 · Compare every method on every downstream task, on many KPIs.
+
+Reads reports/predictions_<name>/<task>.npz (pipeline 6): per test snapshot of a task, the truth and each method's
+predicted probability: LoRA fine-tuning, and the logistic-regression probes on counts, embedding, counts + embedding.
+  ROC-AUC          ranking: a random positive above a random negative (0.5 = coin flip)
+  PR-AUC           average precision: ranking where it matters for rare events (compare with the base rate)
+  log-loss, Brier  are the probabilities right, not only their order (lower is better)
+  precision@10%    contact the 10% highest scored: the share of them who do it (hit rate)
+  recall@10%       ... the share of everyone who does it that was contacted
+  lift@10%         precision@10% / base rate: times better than contacting at random
+  F1@10%           balance of precision and recall at that budget
+  best F1          F1 at its best threshold (optimistic: the threshold is picked on test)
+Every KPI's difference with the counts baseline gets a 95% interval from resampling test customers (their snapshots
+stay together); marked when the interval excludes zero in the better direction.
+
+Writes reports/compare_<name>.md + .json, reports/gains_<name>.png (cumulative gains per task)
+
+Run:  python pipelines/07_compare.py [--name small] [--boot 500] [--budget 0.1]
+"""
+import argparse
+import json
+
+import numpy as np
+from common import REPORTS
+from sklearn.metrics import average_precision_score, brier_score_loss, log_loss, precision_recall_curve, roc_auc_score
+
+p = argparse.ArgumentParser()
+p.add_argument("--name", default="small")
+p.add_argument("--boot", type=int, default=500)
+p.add_argument("--budget", type=float, default=0.1, help="share of snapshots contacted for the @ KPIs")
+a = p.parse_args()
+B = f"{a.budget:.0%}"
+HIGHER = {"ROC-AUC": True, "PR-AUC": True, "log-loss": False, "Brier": False, f"precision@{B}": True, f"recall@{B}": True,
+          f"lift@{B}": True, f"F1@{B}": True, "best F1": True}
+METHODS = {"probe counts": "counts (baseline)", "probe embedding": "embedding probe", "probe counts + embedding": "counts + embedding probe",
+           "LoRA": "LoRA fine-tuned"}
+
+
+def kpis(y, p):
+    k = max(1, int(round(len(p) * a.budget)))
+    hits = y[np.argsort(-p, kind="stable")[:k]].sum()
+    prec, rec = hits / k, hits / max(1, y.sum())
+    pr, rc, _ = precision_recall_curve(y, p)
+    return dict(zip(HIGHER, [roc_auc_score(y, p), average_precision_score(y, p), log_loss(y, np.clip(p, 1e-6, 1 - 1e-6), labels=[0, 1]),
+                             brier_score_loss(y, p), prec, rec, prec / max(y.mean(), 1e-12), 2 * prec * rec / (prec + rec) if hits else 0.0,
+                             float(np.max(2 * pr * rc / np.maximum(pr + rc, 1e-12)))]))
+
+
+files = sorted((REPORTS / f"predictions_{a.name}").glob("*.npz"))
+if not files:
+    raise SystemExit(f"no predictions in reports/predictions_{a.name}: run pipelines/06_finetune.py --name {a.name} first")
+rng, out, lines = np.random.default_rng(0), {}, [f"# All KPIs per downstream task ({a.name}): counts baseline, probes and LoRA", "",
+                                                  f"Test snapshots of test customers. In brackets: the difference with the counts baseline and its 95% interval "
+                                                  f"from {a.boot} resamples of test customers; **better** = better beyond chance. @{B}: contact the {B} highest-scored "
+                                                  "snapshots. Lower is better for log-loss and Brier.", ""]
+for f in files:
+    d, task = np.load(f), f.stem
+    y, groups = d["y"].astype(int), d["group"]
+    preds = {m: d[m] for m in METHODS if m in d.files}
+    point = {m: kpis(y, pm) for m, pm in preds.items()}
+    rows_of = [np.flatnonzero(groups == g) for g in np.unique(groups)]
+    diffs = {m: {k: [] for k in HIGHER} for m in preds if m != "probe counts"}
+    for _ in range(a.boot):
+        idx = np.concatenate([rows_of[i] for i in rng.integers(0, len(rows_of), len(rows_of))])
+        if y[idx].min() == y[idx].max():
+            continue
+        base = kpis(y[idx], preds["probe counts"][idx])
+        for m in diffs:
+            for k, v in kpis(y[idx], preds[m][idx]).items():
+                diffs[m][k].append(v - base[k])
+    out[task] = {"n": len(y), "positives": int(y.sum()), "base_rate": round(float(y.mean()), 4), "methods": {}}
+    lines += [f"## {task}", "", f"{len(y):,} test snapshots, {int(y.sum()):,} positives (base rate {y.mean():.1%}).", "",
+              "| KPI | " + " | ".join(METHODS[m] for m in preds) + " |", "|---" * (len(preds) + 1) + "|"]
+    for m in preds:
+        out[task]["methods"][METHODS[m]] = {k: round(float(v), 4) for k, v in point[m].items()}
+    for k, higher in HIGHER.items():
+        cells = []
+        for m in preds:
+            v = point[m][k]
+            if m == "probe counts":
+                cells.append(f"{v:.3f}")
+                continue
+            lo, hi = np.percentile(diffs[m][k], [2.5, 97.5])
+            better = lo > 0 if higher else hi < 0
+            out[task]["methods"][METHODS[m]][f"{k} vs counts"] = {"diff": round(float(v - point['probe counts'][k]), 4), "low": round(float(lo), 4),
+                                                                   "high": round(float(hi), 4), "better": bool(better)}
+            cells.append(f"{v:.3f} ({v - point['probe counts'][k]:+.3f} [{lo:+.3f}, {hi:+.3f}]){' **better**' if better else ''}")
+        lines.append(f"| {k} | " + " | ".join(cells) + " |")
+    lines.append("")
+
+(REPORTS / f"compare_{a.name}.json").write_text(json.dumps(out, indent=2), encoding="utf-8")
+(REPORTS / f"compare_{a.name}.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+import matplotlib  # noqa: E402
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+
+cols = min(3, len(files))
+fig, axes = plt.subplots((len(files) + cols - 1) // cols, cols, figsize=(5 * cols, 4.2 * ((len(files) + cols - 1) // cols)), squeeze=False)
+for ax, f in zip(axes.flat, files):
+    d = np.load(f)
+    y = d["y"].astype(int)
+    for i, m in enumerate(mm for mm in METHODS if mm in d.files):
+        order = np.argsort(-d[m], kind="stable")
+        ax.plot(np.arange(1, len(y) + 1) / len(y), np.cumsum(y[order]) / max(1, y.sum()), color=f"C{i}", label=METHODS[m])
+    ax.plot([0, 1], [0, 1], color="grey", linestyle="--", linewidth=0.8, label="random")
+    ax.axvline(a.budget, color="black", linewidth=0.6)
+    ax.set_title(f.stem, fontsize=10), ax.set_xlabel("share contacted (highest scores first)"), ax.set_ylabel("share of positives reached")
+    ax.legend(fontsize=7, loc="lower right")
+for ax in list(axes.flat)[len(files):]:
+    ax.axis("off")
+fig.suptitle(f"Cumulative gains per task ({a.name}): reaching the most positives with the fewest contacts")
+fig.tight_layout()
+fig.savefig(REPORTS / f"gains_{a.name}.png", dpi=110)
+print("\n".join(lines))
+print(f"-> {REPORTS / f'compare_{a.name}.md'}, {REPORTS / f'gains_{a.name}.png'}")
